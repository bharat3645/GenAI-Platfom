# Local development .env (ready for docker-compose)
# Use Docker Compose to start Postgres and Mongo locally. The compose file
# defines a Postgres service named `database` and a Mongo service named `mongodb`.
# DATABASE_URL below points to the compose Postgres database. When running in
# production or with an external DB (Neon/Supabase), replace this value.
# Example external format: postgres://username:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://postgres:postgres@database:5432/genai_platform?sslmode=disable

# Mongo (optional) for vector store / auxiliary data. When using Docker Compose
# the hostname is `mongodb` (service name). If you run Mongo locally, change this.
MONGO_URI=mongodb://mongodb:27017/genai_platform

PORT=8080
JWT_SECRET=your-super-secret-jwt-key-here
OPENAI_API_KEY=
GEMINI_API_KEY=
SENDGRID_API_KEY=
UPLOAD_DIR=./uploads

# Frontend dev settings (the Vite server proxies /api to the backend)
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api/v1