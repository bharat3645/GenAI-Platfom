# Database Configuration
# Replace with your Neon database connection string
# Format: postgres://username:password@host.neon.tech:5432/database?sslmode=require
# Note: URL-encode special characters in password (# → %23, @ → %40)
DATABASE_URL=postgres://postgres:yourpassword@your-host.neon.tech:5432/genai_platform?sslmode=require

# Server Configuration
PORT=8080

# Authentication
# Generate a strong random string for production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AI Service Configuration
# Get your API keys from:
# OpenAI: https://platform.openai.com/api-keys
# Gemini: https://makersuite.google.com/app/apikey
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Email Service (Optional)
# Get your API key from: https://sendgrid.com/
SENDGRID_API_KEY=your-sendgrid-api-key

# File Upload Configuration
UPLOAD_DIR=./uploads

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173

# Optional MongoDB URI (for vector store, caching or full migration)
# Example: mongodb://mongouser:password@mongodb:27017/genai_store
MONGO_URI=mongodb://mongouser:password@mongodb:27017/genai_store

# API Configuration (for frontend)
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api/v1
